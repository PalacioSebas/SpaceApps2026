{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi"
    },
    "landing": {
      "root": "landing",
      "framework": "nextjs"
    },
    "landing-llm": {
      "root": "landing-llm",
      "framework": "nextjs"
    },
    "landing-login": {
      "root": "landing-login",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
