{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi"
    },
    "landing": {
      "root": "landing",
      "framework": "nextjs"
    },
    "landing-llm": {
      "root": "landing-llm",
      "framework": "nextjs"
    },
    "landing-login": {
      "root": "landing-login",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/static/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/explorer",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/explorer/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/observatory",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/observatory/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/copilot",
      "destination": {
        "service": "landing-llm"
      }
    },
    {
      "source": "/copilot/(.*)",
      "destination": {
        "service": "landing-llm"
      }
    },
    {
      "source": "/login",
      "destination": {
        "service": "landing-login"
      }
    },
    {
      "source": "/login/(.*)",
      "destination": {
        "service": "landing-login"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "landing"
      }
    }
  ]
}
